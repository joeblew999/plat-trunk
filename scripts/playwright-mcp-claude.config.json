{
  "browser": {
    "browserName": "chromium",
    "launchOptions": {
      "channel": "chrome",
      "args": [
        "--enable-unsafe-webgpu",
        "--enable-features=Vulkan",
        "--use-angle=default",
        "--no-sandbox",
        "--user-data-dir=/tmp/playwright-mcp-claude"
      ]
    }
  }
}
