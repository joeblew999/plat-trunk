# docs/libs/ — generated by `mise run docs:sync`
#
# DO NOT commit files here. This folder is gitignored except for this file.
# Content is copied from lib/*/docs/ by scripts/docs-sync.mjs.
#
# To add a new lib:
#   1. Create lib/{name}/docs/*.md
#   2. Add entry to scripts/docs-sync.mjs libs[] array
#   3. Add sidebar entry in .vitepress/config.ts
#   4. Run: mise run docs:sync
