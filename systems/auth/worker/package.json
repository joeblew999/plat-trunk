{
  "type": "module",
  "scripts": {
    "postinstall": "bun scripts/patch-better-auth.ts",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "auth:generate": "npx auth@latest generate --output src/db/auth.schema.ts -y",
    "auth:migrate:local": "wrangler d1 migrations apply auth-db --local",
    "auth:migrate:prod":  "wrangler d1 migrations apply auth-db --remote",
    "zano:migrate:local": "curl -s -X POST http://localhost:8790/zano/migrate | jq",
    "zano:migrate:prod":  "curl -s -X POST https://cad.ubuntusoftware.net/zano/migrate | jq",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@better-auth/oauth-provider": "^1.5",
    "@cloudflare/shell":           "^0.3.1",
    "@hono/swagger-ui":            "^0.6.1",
    "@hono/zod-openapi":           "^0.18.0",
    "@zanzojs/core":               "^0.3.0",
    "better-auth":                 "^1.5",
    "drizzle-orm":                 "^0.38",
    "hono":                        "^4",
    "zod":                         "^3.24.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4",
    "drizzle-kit": "^0.31",
    "typescript": "^5",
    "wrangler": "^4"
  }
}
