{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["@cloudflare/workers-types"],
    "baseUrl": ".",
    "paths": {
      "hono": ["../../worker/node_modules/hono"],
      "hono/*": ["../../worker/node_modules/hono/*"],
      "@hono/zod-openapi": ["../../worker/node_modules/@hono/zod-openapi"],
      "@hono/zod-openapi/*": ["../../worker/node_modules/@hono/zod-openapi/*"],
      "@hono/mcp": ["../../worker/node_modules/@hono/mcp"],
      "@hono/mcp/*": ["../../worker/node_modules/@hono/mcp/*"],
      "@modelcontextprotocol/*": ["../../worker/node_modules/@modelcontextprotocol/*"]
    }
  },
  "include": ["*.ts"]
}
