{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": [
    "**/*.ts"
  ],
  "exclude": [
    "dist/**",
    "node_modules/**",
    "pkg-browser-renderer/**",
    "../worker/**",
    "../crate/**"
  ]
}