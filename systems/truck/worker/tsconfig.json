{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "types": ["@cloudflare/workers-types"],
    "lib": ["ESNext"],
    "baseUrl": ".",
    "paths": {
      "hono": ["node_modules/hono"],
      "hono/*": ["node_modules/hono/*"]
    }
  },
  "include": ["src/**/*.ts", "../web/src/**/*.ts"]
}
