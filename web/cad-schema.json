          "height": {
            "default": 1.0,
            "format": "double",
            "type": "number"
          },
          "radius": {
            "default": 0.5,
            "format": "double",
            "type": "number"
          }
        },
        "title": "AddCylinderParams",
        "type": "object"
      },
      "readonly": false,
      "returns": "objectId"
    },
    "add_sphere": {
      "description": "Add a sphere primitive",
