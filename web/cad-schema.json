      "description": "Add a cube primitive",
      "ephemeral": false,
      "params": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "properties": {
          "size": {
            "default": 1.0,
            "format": "double",
            "type": "number"
          }
        },
        "title": "AddCubeParams",
        "type": "object"
      },
      "readonly": false,
      "returns": "objectId"
