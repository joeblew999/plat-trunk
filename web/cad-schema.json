    "set_style": {
      "description": "Set object material style",
      "ephemeral": false,
      "layer": "wasm",
      "params": {
        "properties": {
          "objectId": {
            "type": "string"
          },
          "style": {
            "description": "Material style: albedo [r,g,b,a], roughness, reflectance, ambient_ratio (all 0-1)",
            "properties": {
              "albedo": {
                "description": "RGBA color array, each value 0-1",
                "items": {
                  "type": "number"
                },
                "maxItems": 4,
                "minItems": 4,
                "type": "array"
              },
              "ambient_ratio": {
                "description": "Ambient light ratio (0-1)",
                "type": "number"
              },
              "reflectance": {
                "description": "Surface reflectance (0-1)",
                "type": "number"
              },
              "roughness": {
                "description": "Surface roughness (0 = mirror, 1 = matte)",
                "type": "number"
              }
            },
            "type": "object"
          }
        },
        "required": [
          "objectId",
          "style"
        ],
        "type": "object"
      },
      "readonly": false,
      "returns": "success"
    },
