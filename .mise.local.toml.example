# .mise.local.toml.example
#
# ── Secrets are now managed via Doppler ──────────────────────────────────────
#
# Human devs (one-time setup):
#   mise install          # installs doppler + all tools
#   doppler login         # browser OAuth — links your machine to Doppler
#   # Done. Secrets inject automatically when you cd into this repo.
#
# Claude / CI container:
#   Generate a service token at:
#     https://dashboard.doppler.com/workplace/plat-trunk/configs/dev/access
#   Then pass it as an env var:
#     DOPPLER_TOKEN=dp.st.dev.xxxx mise run deploy
#
# ── You only need this file if you can't use Doppler ─────────────────────────
# (e.g. offline, or Doppler is down — unlikely but possible)
#
# cp .mise.local.toml.example .mise.local.toml  and fill in values below.
# .mise.local.toml is gitignored — never commit it.
#
# [env]
#
# # Cloudflare API Token
# #   Create:  https://dash.cloudflare.com/profile/api-tokens
# CLOUDFLARE_API_TOKEN = ""
#
# # Cloudflare Account ID
# #   Find:    https://dash.cloudflare.com → right sidebar
# CLOUDFLARE_ACCOUNT_ID = ""
#
# # GitHub Personal Access Token
# #   Create:  https://github.com/settings/tokens  (scopes: repo, workflow)
# GITHUB_TOKEN = ""
