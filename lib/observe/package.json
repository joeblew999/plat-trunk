{
  "name": "plat-observe",
  "private": true,
  "scripts": {
    "kill": "mise run kill",
    "dev": "mise run dev",
    "deploy": "mise run deploy",
    "tail": "mise run tail",
    "test": "bun tests/integration.test.ts",
    "test:e2e": "bun tests/e2e.spec.ts",
    "test:rust": "cargo test -p plat-observe --lib",
    "build:wasm": "wasm-pack build crate --out-dir pkg --target bundler --no-pack && bun dev/gen-wasm.ts && echo 'WASM built → crate/pkg/'",
    "build:wasm:web": "cd demo-line && bun run build:wasm",
    "gen:wasm": "bun dev/gen-wasm.ts",
    "check:wasm": "bun dev/gen-wasm.ts --check",
    "gen:types": "bun dev/gen-types.ts",
    "check:types": "bun dev/gen-types.ts --check",
    "gen:zod": "bun dev/gen-zod.ts",
    "check:zod": "bun dev/gen-zod.ts --check",
    "gen:openapi": "bun dev/gen-openapi.ts",
    "check:openapi": "bun dev/gen-openapi.ts --check",
    "gen": "bun run gen:types && bun run gen:zod && bun run gen:openapi",
    "dev:line": "bun run kill && cd demo-line && bun run dev",
    "deploy:line": "cd demo-line && bun run deploy",
    "tail:line": "cd demo-line && bun run tail",
    "dev:tauri": "cd demo-tauri && bun run dev",
    "build:tauri": "cd demo-tauri && bun run build",
    "ios:init": "cd demo-tauri && bun run ios:init",
    "ios:runtime": "cd demo-tauri && bun run ios:runtime",
    "ios:dev": "cd demo-tauri && bun run ios:dev",
    "ios:build": "cd demo-tauri && bun run ios:build",
    "ios:open": "cd demo-tauri && bun run ios:open"
  },
  "dependencies": {
    "hono": "4.11.9",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260212.0",
    "bun-types": "^1.3.10",
    "playwright": "^1.50.0",
    "wait-on": "^8.0.0",
    "wrangler": "^4.72.0"
  }
}
